# dependencies
node_modules/
.pnpm-store/

# builds
dist/
dist-cli/
.next/
.next-e2e/
out/
*.tsbuildinfo
next-env.d.ts
coverage/
.turbo/

# Playwright (end-to-end) artefacts
apps/web/e2e/.artifacts/
playwright-report/
blob-report/
.playwright/

# generated at build time (committed generated contracts live elsewhere)
apps/api/src/generated/
apps/web/public/sw.js*
apps/web/public/swe-worker*

# env files — only .env.example is committed
.env
.env.*
!.env.example
!.env.test

# python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log

# CV comparison reports and sample CVs: personal data, never committed
apps/ai-worker/.cv-compare/
sample-cvs/

# Playwright MCP snapshots and draft screenshots
.playwright-mcp/

# Visual review screenshots (e2e/visual): looked at, never committed
screenshots/

# Local database backups (pg_dump before a risky migration): never committed
.backups/

# Word lock files: Word writes ~$name.docx beside any document it has open
~$*

# Word copies of a document whose source is the Markdown beside it: generate on demand
docs/*.docx
