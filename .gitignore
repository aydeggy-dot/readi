# dependencies
node_modules/
.pnpm-store/

# builds
dist/
dist-cli/
.next/
.next-e2e/
out/
*.tsbuildinfo
next-env.d.ts
coverage/
.turbo/

# Playwright (end-to-end) artefacts
apps/web/e2e/.artifacts/
playwright-report/
blob-report/
.playwright/

# generated at build time (committed generated contracts live elsewhere)
apps/api/src/generated/
apps/web/public/sw.js*
apps/web/public/swe-worker*

# env files — only .env.example is committed
.env
.env.*
!.env.example
!.env.test

# python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log

# CV comparison reports and sample CVs: personal data, never committed
apps/ai-worker/.cv-compare/
sample-cvs/

# Playwright MCP snapshots and draft screenshots
.playwright-mcp/

# Visual review screenshots (e2e/visual): looked at, never committed
screenshots/

# Local database backups (pg_dump before a risky migration): never committed
.backups/

# Word lock files: Word writes ~$name.docx beside any document it has open
~$*

# Word copies of a document whose source is the Markdown beside it: generate on demand
docs/*.docx

# A harness run on the stand-in evaluator. `evals/results/` is the record of what paid runs
# measured and every report is recomputed from it, so a free run that scores on whether the word
# "because" appears does not belong in it — and two of them reached a commit by `git add -A`
# before this line existed.
evals/results/*-fake.json

# Benchmark audio is personal data from people who are not users of the product (ADR-0020 §8): it never
# enters the repository, the database or the application's buckets. The manifests and the result JSONs
# are what belong in git — they are the record of how a recogniser was chosen.
evals/stt_benchmark/synthetic/*.wav
evals/stt_benchmark/synthetic/*.mp3
evals/stt_benchmark/real/
