# AI worker configuration. Copy to apps/ai-worker/.env for local development.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Redis from infra/docker-compose.yml (host port 16379).
REDIS_URL=redis://127.0.0.1:16379/0
HEALTH_CHECK_TIMEOUT_MS=2000
# Leave empty to disable Sentry.
SENTRY_DSN=

# API → worker authentication (ADR-0004): the same value as AI_WORKER_TOKEN in apps/api/.env.
# Generate with: openssl rand -base64 48
SERVICE_TOKEN=

# LLM adapter (ADR-0010). `anthropic` needs ANTHROPIC_API_KEY (console.anthropic.com → API keys).
# `fake` parses with a keyword stand-in and calls no provider: for local work without a key.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model for CV parsing (prices in readi_worker/llm/pricing.py). Compare models on real CVs with
# `uv run python -m readi_worker.tools.compare_cv_parse <folder>`.
LLM_MODEL_CV_PARSE=claude-sonnet-5
LLM_TIMEOUT_S=90

# Embedding adapter (ADR-0006), used for question near-duplicate detection.
# `fake` derives a deterministic vector from the text: no key, no network, no cost — and no
# judgement about wording, so duplicate warnings only become meaningful on `voyage`.
# `voyage` needs VOYAGE_API_KEY (voyageai.com -> API keys). After switching, re-embed with
# `pnpm --filter @readi/api content:reembed`.
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=
# Must produce vectors of EMBEDDING_DIMENSIONS; that must match the vector(N) column in the
# migration (1024). The worker refuses an answer of any other length.
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_S=30
