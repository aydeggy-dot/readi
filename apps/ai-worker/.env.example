# AI worker configuration. Copy to apps/ai-worker/.env for local development.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Redis from infra/docker-compose.yml (host port 16379).
REDIS_URL=redis://127.0.0.1:16379/0
HEALTH_CHECK_TIMEOUT_MS=2000
# Leave empty to disable Sentry.
SENTRY_DSN=
