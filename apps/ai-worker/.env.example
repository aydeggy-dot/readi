# AI worker configuration. Copy to apps/ai-worker/.env for local development.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Redis from infra/docker-compose.yml (host port 16379).
REDIS_URL=redis://127.0.0.1:16379/0
HEALTH_CHECK_TIMEOUT_MS=2000
# Leave empty to disable Sentry.
SENTRY_DSN=

# API → worker authentication (ADR-0004): the same value as AI_WORKER_TOKEN in apps/api/.env.
# Generate with: openssl rand -base64 48
SERVICE_TOKEN=

# LLM adapter (ADR-0010). `anthropic` needs ANTHROPIC_API_KEY (console.anthropic.com → API keys).
# `fake` parses with a keyword stand-in and calls no provider: for local work without a key.
#
# **`fake` is the default on purpose** (owner's decision, 2026-09-26). An interview costs real money
# per run, and a dev stack is left running for days: the first paid run was diagnosed twice partly
# because nobody could tell from the outside which provider the worker had. Arm a paid run on the
# command line, for the length of that run —
#   LLM_PROVIDER=anthropic LLM_MODEL_INTERVIEWER=claude-sonnet-5 uv run python -m readi_worker
# — and leave this file saying `fake`, so the resting state of the stack is free. `Settings` forbids
# `fake` in production, so this cannot leak into a deployment.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# Model for CV parsing (prices in readi_worker/llm/pricing.py). Compare models on real CVs with
# `uv run python -m readi_worker.tools.compare_cv_parse <folder>`.
LLM_MODEL_CV_PARSE=claude-sonnet-5
# Model for the live interviewer (M3): phrasing a question or a follow-up, and judging whether an
# answer already covered a probe. A fast model, because the candidate is waiting for it; M4's
# evaluator is a separate, stronger one. Roughly 2-4 cents per 30-minute text mock.
LLM_MODEL_INTERVIEWER=claude-sonnet-5
# Model for the evaluator (M4): scoring one answer against its rubric. A **stronger** model than the
# interviewer, and the one place in the product where that is worth paying for — the quality of the
# feedback is what we are selling (product principle 1), and this runs once per answer rather than
# once per turn. Roughly 3c per answer against the interviewer's ~0.5c per turn, so it about triples
# the cost of a session: 12c for a 15-minute mock (4 answers), 24c for a 30-minute one (8).
#
# Whether opus actually agrees with human scorers better than sonnet is a question for the eval
# harness, not for taste — `uv run python -m readi_worker.evals.run` answers it once experts have
# scored real answers, and the owner has asked for that comparison explicitly.
LLM_MODEL_EVALUATOR=claude-opus-5
LLM_TIMEOUT_S=90
# Per interview call, and much shorter on purpose: a CV is parsed in a background job, an interview
# turn has a candidate watching a spinner. Two chained calls is the worst case one exchange puts in
# front of them, and the API's AI_WORKER_TIMEOUT_MS is sized from it.
INTERVIEW_LLM_TIMEOUT_S=45
# Per interview call **in voice mode** (M5 phase 3), and much shorter again: 45 seconds is right for
# somebody watching a spinner and absurd in a conversation — by then the candidate has said "hello?"
# twice. A call slower than this falls back to the pinned staff-written wording, which is a plainer
# interview rather than a broken one.
VOICE_LLM_TIMEOUT_S=10
# Per evaluator call. Nobody is watching a spinner — scoring runs in a queue once the session has
# ended — but the report is promised within 60 seconds of that (spec §8) and the API scores several
# answers at once, so a call slower than this has already lost the race and is better retried.
EVALUATION_LLM_TIMEOUT_S=60

# Ask the evaluator for a per-rubric output schema in which a criterion cannot be left out or
# invented (readi_worker/evaluation/strict_schema.py). The structural answer to `rejected_criteria`,
# which two rounds of prompt wording failed to fix. Leave it true: measured 2026-09-28 over 60
# answers and all twelve rubrics of the paid comparison — 0 rejected readings over 60 calls against
# a matched baseline of 25%, nothing unscoreable, both separations 12 of 12, fairness inside the band
# on all 36 criteria, and a fifth off the bill. Setting it false goes back to an evaluator that threw
# away a quarter of its readings, so it is a diagnostic and not a fallback.
EVALUATOR_STRICT_CRITERIA_SCHEMA=true

# How long Redis keeps a session's bundle and engine state. It is a cache: the snapshot the API
# sends is always the authority, so expiry costs one round trip (the worker asks for the bundle
# again) and never a session. Two hours covers a 30-minute session plus its resume grace period.
INTERVIEW_STATE_TTL_S=7200

# LLM tracing (ADR-0008). Langfuse stores our prompts, and our prompts contain candidate answers
# and CV text — so it is a personal-data store, not a log sink: EU region, opaque ids only,
# contact details masked on the way out, traces deleted on account erasure and after
# LANGFUSE_RETENTION_DAYS.
#
# **Tracing is off unless BOTH keys are set**, which is local development, CI and the e2e run:
# nothing is constructed, nothing is sent, and `ai_call_log.langfuse_trace_id` stays null. One key
# without the other is refused at startup rather than silently disabled.
#
# To turn it on, follow docs/runbooks/langfuse-enable.md. In short: sign up on the **EU** region
# at https://cloud.langfuse.com, create a project, and paste its key pair here. Regions are wholly
# separate accounts — the US region is https://us.cloud.langfuse.com and is NOT where these traces
# may live (ADR-0008), and moving later means a new account and a migration.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# How long a trace lives. The hourly sweep on the API side asks the worker to delete anything
# older; keep it in step with the recordings retention M5 adds.
LANGFUSE_RETENTION_DAYS=30
LANGFUSE_TIMEOUT_S=10

# Embedding adapter (ADR-0006), used for question near-duplicate detection.
# `fake` derives a deterministic vector from the text: no key, no network, no cost — and no
# judgement about wording, so duplicate warnings only become meaningful on `voyage`.
# `voyage` needs VOYAGE_API_KEY (voyageai.com -> API keys). After switching, re-embed with
# `pnpm --filter @readi/api content:reembed`.
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=
# Must produce vectors of EMBEDDING_DIMENSIONS; that must match the vector(N) column in the
# migration (1024). The worker refuses an answer of any other length.
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_S=30

# Speech adapters (M5, ADR-0019/ADR-0020): recognition and synthesis.
#
# `fake` is the resting state for the same reason LLM_PROVIDER=fake is — a voice session bills by
# the minute and a dev stack runs for days. The fake recogniser answers deterministically from the
# audio and the fake synthesizer returns silence of a plausible length: no key, no network, no cost.
#
# **A provider readi_worker/speech/pricing.py cannot price refuses to start** (owner's instruction,
# 2026-09-29). A language model bills per call and an unpriced one is a zero somebody notices that
# day; recognition and synthesis bill per minute and per character, monthly, in arrears — so an
# unpriced one is a cost nobody sees until the invoice.
#
# Which provider is a fairness decision taken on real recordings in M5 phase 6 (ADR-0020), not a
# default someone picked: until then the only implemented name is `fake`.
VOICE_ENABLED=false
# Implemented recognisers: fake, deepgram, assemblyai, intron. Priced (and therefore startable) today:
#   deepgram   nova-3            $0.0077/min of audio, streaming   (a promo of $0.0048 was live 2026-09-29)
#   deepgram   flux-general-en   $0.0077/min of audio, streaming
#   assemblyai universal-streaming-en  $0.15/hour of **session** — the socket being open, not the audio
#   assemblyai universal-3-5-pro / universal-2   batch only
#   intron     — NOT priced: they publish no rates at all, so the worker refuses to start with it.
#                It is a benchmark reference (batch, 300 s streaming cap, no word timings), not a live
#                recogniser. Ask voice@intron.io for a rate and their data terms before that changes.
STT_PROVIDER=fake
STT_MODEL=fake
# Nigerian English is `en` to most providers today; whether any offers better is what phase 6 asks.
STT_LANGUAGE=en
STT_TIMEOUT_S=20
# Implemented synthesizers: fake, elevenlabs. Priced: eleven_flash_v2_5 and
# eleven_v3_conversational at $0.04/1k characters, eleven_multilingual_v2 and eleven_v3 at $0.08.
# The rate is the same on every self-serve plan — a plan buys a dollar balance, not a discount.
# Flash for the live turns (~75 ms), the higher-quality model for the lines we pre-render once.
TTS_PROVIDER=fake
TTS_MODEL=fake
# One default Nigerian-accented voice, chosen by a blind panel in phase 7. There are 168 voices with
# accent=nigerian in the shared library, 22 of them tagged conversational; list them with
#   uv run python -m readi_worker.tools.list_voices --accent nigerian
TTS_VOICE=fake
TTS_TIMEOUT_S=20
# The technical vocabulary sent to the recogniser as custom vocabulary, and scored as its own subset
# by the accent benchmark — one file so the two cannot drift. Empty finds it in the checkout; a
# deployment that carries no repository sets the path. It holds 302 terms and **no live path accepts
# that many** (100 on Deepgram and on AssemblyAI streaming), so the file's order decides which
# technical words a candidate can afford to have misheard.
GLOSSARY_PATH=

# Provider keys. A real provider without its key is refused at startup, naming the variable — the same
# rule as ANTHROPIC_API_KEY and VOYAGE_API_KEY. Never commit a value here: this file is the tracked
# template, and the real one beside it is git-ignored.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
INTRON_API_KEY=
ELEVENLABS_API_KEY=

# LiveKit (M5 phase 3+). The agent connects to the room with these; the API needs the same three,
# because it is the API that mints a candidate's short-lived join token after checking consent and
# allowance. The dev server from infra/docker-compose.yml is ws://127.0.0.1:7880 with devkey/secret.
#
# With VOICE_ENABLED=true all three are **required at startup**: a candidate pressing "start voice
# interview" and getting nothing is a worse failure than a boot that names the missing variable.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The agent's name in LiveKit. Dispatch is explicit — the API dispatches this name to a room when a
# candidate asks for a voice session — because an implicitly dispatched agent joins every room,
# including rooms with no interview behind them.
VOICE_AGENT_NAME=readi-interviewer

# Where the API is, for the voice agent's three internal routes (ADR-0019 §3): it pulls the session
# bundle and pushes each completed exchange back. The same name the web app uses for the same thing,
# and the only place in the worker that calls the API — every other direction is API → worker.
API_INTERNAL_URL=http://127.0.0.1:4000
# How long the agent waits on one of those calls. Short: the candidate is in a conversation, and a
# push that cannot land is retried and then replayed by the next leg (the API's stored snapshot is
# the authority, ADR-0016 §4).
API_TIMEOUT_S=10
