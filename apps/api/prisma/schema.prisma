// Prisma owns the database schema and all migrations; only apps/api connects to Postgres (ADR-0004).
// The pgvector extension is enabled by the initial migration (raw SQL); vector columns arrive in M2.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Proves that migrations have run; read by GET /health.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("health_check")
}

// ---------------------------------------------------------------------------------------------
// Identity (Better Auth tables, ADR-0005/0009). Field names must match Better Auth's schema; the
// columns are snake_case. Timestamps are timestamptz (CLAUDE.md §5).

enum Role {
  candidate
  content_expert
  admin

  @@map("role")
}

enum SignupMethod {
  email
  google
  phone

  @@map("signup_method")
}

model User {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  /// Phone sign-ups hold a placeholder under the reserved .invalid TLD (ADR-0009); never shown or emailed.
  email                String       @unique
  emailVerified        Boolean      @default(false) @map("email_verified")
  image                String?
  /// E.164.
  phoneNumber          String?      @unique @map("phone_number")
  phoneNumberVerified  Boolean?     @default(false) @map("phone_number_verified")
  role                 Role         @default(candidate)
  signupMethod         SignupMethod @map("signup_method")
  country              String?
  locale               String?
  /// Soft delete (ADR-0011): set when the user asks to delete their account.
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletionScheduledFor DateTime?    @map("deletion_scheduled_for") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  accounts Account[]
  profile  Profile?
  consents ConsentRecord[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// Password hash (email + password accounts only).
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------------------------
// Profile and consent (spec §4.1, §6.1). Personal data: deleted with the user (cascade).

enum TargetRole {
  frontend
  backend
  qa

  @@map("target_role")
}

enum ExperienceLevel {
  intern_junior
  mid

  @@map("experience_level")
}

enum TargetCompanyType {
  local_startup
  enterprise_bank_telco
  remote_foreign
  big_tech

  @@map("target_company_type")
}

model Profile {
  userId                String            @id @map("user_id") @db.Uuid
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole            TargetRole        @map("target_role")
  level                 ExperienceLevel
  yearsExperience       Int               @map("years_experience")
  stack                 String[]
  targetCompanyType     TargetCompanyType @map("target_company_type")
  /// A calendar date, not a timestamp.
  targetDate            DateTime?         @map("target_date") @db.Date
  onboardingCompletedAt DateTime?         @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

enum ConsentType {
  audio_processing
  recording_storage
  camera_coaching
  marketing

  @@map("consent_type")
}

/// Append-only: one row per change of a consent decision. The latest row per (user, type) is the
/// current state; spec §6.1 `granted_at`/`revoked_at` are the `created_at` of granting/revoking rows.
model ConsentRecord {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  /// Version of the consent text the user was shown (CONSENT_VERSIONS in @readi/shared-types).
  version   Int
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, type, createdAt])
  @@map("consent_records")
}

// ---------------------------------------------------------------------------------------------
// Audit and deletion (ADR-0011). Rows kept after account deletion reference users by plain uuid
// (no foreign key) so the reference can be replaced by a tombstone id.

enum AuditActorType {
  user
  admin
  system

  @@map("audit_actor_type")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  /// User or tombstone id; null for system actions.
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id") @db.Uuid
  /// Snapshots must not contain personal data beyond ids (they outlive account deletion).
  before     Json?
  after      Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Replacement identity for retained rows of a deleted user. Deliberately not linked to the old id.
model UserTombstone {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("user_tombstones")
}
