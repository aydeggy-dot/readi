// Prisma owns the database schema and all migrations; only apps/api connects to Postgres (ADR-0004).
// The pgvector extension is enabled by the initial migration (raw SQL); vector columns arrive in M2.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Proves that migrations have run; read by GET /health.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("health_check")
}

// ---------------------------------------------------------------------------------------------
// Identity (Better Auth tables, ADR-0005/0009). Field names must match Better Auth's schema; the
// columns are snake_case. Timestamps are timestamptz (CLAUDE.md §5).

enum Role {
  candidate
  content_expert
  admin

  @@map("role")
}

enum SignupMethod {
  email
  google
  phone

  @@map("signup_method")
}

model User {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  /// Phone sign-ups hold a placeholder under the reserved .invalid TLD (ADR-0009); never shown or emailed.
  email                String       @unique
  emailVerified        Boolean      @default(false) @map("email_verified")
  image                String?
  /// E.164.
  phoneNumber          String?      @unique @map("phone_number")
  phoneNumberVerified  Boolean?     @default(false) @map("phone_number_verified")
  role                 Role         @default(candidate)
  signupMethod         SignupMethod @map("signup_method")
  country              String?
  locale               String?
  /// Soft delete (ADR-0011): set when the user asks to delete their account.
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletionScheduledFor DateTime?    @map("deletion_scheduled_for") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions     Session[]
  accounts     Account[]
  profile      Profile?
  consents     ConsentRecord[]
  contentFlags ContentFlag[]
  interviews   InterviewSession[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// Password hash (email + password accounts only).
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------------------------
// Profile and consent (spec §4.1, §6.1). Personal data: deleted with the user (cascade).

enum TargetCompanyType {
  local_startup
  enterprise_bank_telco
  remote_foreign
  big_tech

  @@map("target_company_type")
}

model Profile {
  userId                String            @id @map("user_id") @db.Uuid
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which role and level this candidate is preparing for, from the catalogue (ADR-0015). Plain
  /// foreign keys, not enums: adding a role is a content task. `onDelete` is left at the default
  /// (restrict) on purpose — a role a candidate is preparing for cannot be deleted out from under
  /// them, and the CMS retires content rather than deleting it.
  /// `Restrict` spelled out on all three, although it is already Prisma's default for a required
  /// relation: making one of these nullable later would silently flip the generated SQL to
  /// `SET NULL`, and a deleted role would blank every candidate's choice with nothing in the diff
  /// that looks dangerous (M2.5 review, 2026-09-22).
  targetRoleId          String            @map("target_role_id") @db.Uuid
  targetRole            CareerRole        @relation(fields: [targetRoleId], references: [id], onDelete: Restrict)
  targetLevelId         String            @map("target_level_id") @db.Uuid
  targetLevel           CareerLevel       @relation(fields: [targetLevelId], references: [id], onDelete: Restrict)
  /// The stack variant they are interviewing for, when they have chosen one (ADR-0015). Nullable:
  /// a role need not offer any, and "I have not decided" is a real answer. It decides which
  /// stack-tagged questions they are offered — see `question-eligibility.ts`.
  targetStackId         String?           @map("target_stack_id") @db.Uuid
  targetStack           Stack?            @relation(fields: [targetStackId], references: [id], onDelete: Restrict)
  yearsExperience       Int               @map("years_experience")
  /// What the candidate says they know, free text. Not `targetStackId`, which is the catalogue
  /// variant they are interviewing for; both were called "stack" until M2.5.
  technologies          String[]
  targetCompanyType     TargetCompanyType @map("target_company_type")
  /// A calendar date, not a timestamp.
  targetDate            DateTime?         @map("target_date") @db.Date
  onboardingCompletedAt DateTime?         @map("onboarding_completed_at") @db.Timestamptz(6)
  /// CV (spec §4.1): the accepted file in object storage and its parsed, candidate-editable content.
  cvStatus              CvStatus          @default(none) @map("cv_status")
  cvFileKey             String?           @map("cv_file_key")
  cvContentType         String?           @map("cv_content_type")
  cvUploadedAt          DateTime?         @map("cv_uploaded_at") @db.Timestamptz(6)
  cvParsed              Json?             @map("cv_parsed")
  cvParsedAt            DateTime?         @map("cv_parsed_at") @db.Timestamptz(6)
  cvEditedAt            DateTime?         @map("cv_edited_at") @db.Timestamptz(6)
  /// Why parsing did not succeed (CvParseError in @readi/shared-types); never CV content.
  cvError               String?           @map("cv_error")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([targetRoleId])
  @@index([targetLevelId])
  @@index([targetStackId])
  @@map("profiles")
}

enum CvStatus {
  none
  processing
  parsed
  unreadable
  failed

  @@map("cv_status")
}

enum ConsentType {
  audio_processing
  recording_storage
  camera_coaching
  marketing

  @@map("consent_type")
}

/// Append-only: one row per change of a consent decision. The latest row per (user, type) is the
/// current state; spec §6.1 `granted_at`/`revoked_at` are the `created_at` of granting/revoking rows.
model ConsentRecord {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  /// Version of the consent text the user was shown (CONSENT_VERSIONS in @readi/shared-types).
  version   Int
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, type, createdAt])
  @@map("consent_records")
}

// ---------------------------------------------------------------------------------------------
// Audit and deletion (ADR-0011). Rows kept after account deletion reference users by plain uuid
// (no foreign key) so the reference can be replaced by a tombstone id.

enum AuditActorType {
  user
  admin
  system

  @@map("audit_actor_type")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  /// User or tombstone id; null for system actions.
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  targetType String         @map("target_type")
  targetId   String?        @map("target_id") @db.Uuid
  /// Snapshots must not contain personal data beyond ids (they outlive account deletion).
  before     Json?
  after      Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Replacement identity for retained rows of a deleted user. Deliberately not linked to the old id.
model UserTombstone {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("user_tombstones")
}

// ---------------------------------------------------------------------------------------------
// AI cost accounting (ADR-0007). One row per external AI call, reported by the worker. No content
// and no personal data: user and session are plain uuids (no foreign key), replaced by a tombstone
// id on account deletion (ADR-0011).

enum AiCallPurpose {
  interviewer
  /// The judgement that decides whether a probe is still worth asking (M3, the interview engine).
  /// Its own purpose rather than `follow_up`, so "what the follow-up machinery costs" and "what we
  /// spent phrasing one" stay separable in `ai_call_log` — they are different calls with different
  /// shapes and one of them is the one the latency savings skip.
  coverage
  follow_up
  evaluator
  cv_parse
  plan_summary
  embedding
  stt
  tts
  avatar

  @@map("ai_call_purpose")
}

enum AiUnitKind {
  tokens
  characters
  seconds

  @@map("ai_unit_kind")
}

enum AiCallStatus {
  ok
  error

  @@map("ai_call_status")
}

model AiCallLog {
  id              String        @id @default(uuid()) @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  sessionId       String?       @map("session_id") @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  purpose         AiCallPurpose
  provider        String
  model           String
  status          AiCallStatus
  errorCode       String?       @map("error_code")
  latencyMs       Int           @map("latency_ms")
  inputUnits      Int           @map("input_units")
  outputUnits     Int           @map("output_units")
  unitKind        AiUnitKind    @map("unit_kind")
  /// Integer micro-USD (1 USD = 1,000,000).
  costMicroUsd    BigInt        @map("cost_micro_usd")
  langfuseTraceId String?       @map("langfuse_trace_id")

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_call_log")
}

// ---------------------------------------------------------------------------------------------
// Learning content (spec §4.2, §4.8, §6.1; ADR-0014). Status lives on the publishable units —
// Track, Lesson, Question and Rubric; a Module is structural and inherits its track's status.
// Only `published` content reaches candidates, and candidate responses never carry rubrics,
// criteria, level descriptors or ideal points.
//
// `created_by_user_id` / `changed_by_user_id` are plain uuids with NO foreign key: content
// outlives the account that wrote it, so erasure replaces them with a tombstone id (ADR-0011) and
// they are listed in TOMBSTONED_COLUMNS. A candidate's own flag is the opposite case and cascades.

enum ContentStatus {
  draft
  in_review
  published
  retired

  @@map("content_status")
}

enum QuestionType {
  behavioral
  technical
  scenario
  test_design

  @@map("question_type")
}

enum ContentEntityType {
  track
  module
  lesson
  question
  rubric
  career_role
  career_level
  stack

  @@map("content_entity_type")
}

// ---------------------------------------------------------------------------------------------
// The catalogue (ADR-0015): career roles, the levels each is hired at, and the stack variants a
// candidate can be interviewed for. Publishable content with the same workflow, history, audit
// trail and review state as a question — so adding a role is a content task, not a migration.
//
// As of M2.5 phase 3 these tables *are* the closed set: the `target_role` and `experience_level`
// enums are gone, and tracks, questions and profiles carry foreign keys into the catalogue.

/// One role a candidate prepares for (frontend, backend, QA…). `slug` is what the wire carries.
model CareerRole {
  id                     String         @id @default(uuid()) @db.Uuid
  slug                   String         @unique
  name                   String
  summary                String?
  /// Order in the list a candidate chooses from; ties break by name.
  position               Int
  /// Which kinds of question a session for this role may use (M3 reads it).
  supportedQuestionTypes QuestionType[] @map("supported_question_types")
  status                 ContentStatus  @default(draft)
  version                Int            @default(1)
  /// See `Topic.seedManaged`: `/content/seed` owns this row's content until the CMS edits it.
  seedManaged            Boolean        @default(false) @map("seed_managed")
  createdByUserId        String?        @map("created_by_user_id") @db.Uuid
  publishedAt            DateTime?      @map("published_at") @db.Timestamptz(6)
  /// See `Track.aiDraftUnreviewed` (ADR-0014 decision 6).
  aiDraftUnreviewed      Boolean        @default(false) @map("ai_draft_unreviewed")
  reviewedByUserId       String?        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt             DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  levels CareerRoleLevel[]
  stacks CareerRoleStack[]

  tracks     Track[]
  questions  QuestionCareerRole[]
  profiles   Profile[]
  interviews InterviewSession[]

  @@index([status])
  /// The CMS list order (`updated_at desc, id desc`).
  @@index([updatedAt, id])
  @@map("career_roles")
}

/// One rung of the ladder (intern/junior, mid, senior). `rank` orders levels against each other.
model CareerLevel {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  name              String
  summary           String?
  /// Lowest first, sparse by convention so a level can be inserted without renumbering.
  rank              Int
  status            ContentStatus @default(draft)
  version           Int           @default(1)
  /// See `Topic.seedManaged`.
  seedManaged       Boolean       @default(false) @map("seed_managed")
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  /// See `Track.aiDraftUnreviewed` (ADR-0014 decision 6).
  aiDraftUnreviewed Boolean       @default(false) @map("ai_draft_unreviewed")
  reviewedByUserId  String?       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles CareerRoleLevel[]

  tracks     Track[]
  questions  QuestionCareerLevel[]
  profiles   Profile[]
  interviews InterviewSession[]

  @@index([status])
  @@index([updatedAt, id])
  @@map("career_levels")
}

/// A technology variant a role is interviewed for ("Java / Spring", not "backend").
model Stack {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  name              String
  summary           String?
  status            ContentStatus @default(draft)
  version           Int           @default(1)
  /// See `Topic.seedManaged`.
  seedManaged       Boolean       @default(false) @map("seed_managed")
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  /// See `Track.aiDraftUnreviewed` (ADR-0014 decision 6).
  aiDraftUnreviewed Boolean       @default(false) @map("ai_draft_unreviewed")
  reviewedByUserId  String?       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles CareerRoleStack[]

  questions  QuestionStack[]
  profiles   Profile[]
  interviews InterviewSession[]

  @@index([status])
  @@index([updatedAt, id])
  @@map("stacks")
}

/// Which levels a role is hired at, in display order. The `TrackTopic` shape.
model CareerRoleLevel {
  roleId   String      @map("role_id") @db.Uuid
  role     CareerRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  levelId  String      @map("level_id") @db.Uuid
  level    CareerLevel @relation(fields: [levelId], references: [id])
  position Int

  @@id([roleId, levelId])
  @@index([levelId])
  @@map("career_role_levels")
}

/// Which stack variants a role offers, in display order; `is_default` is where a picker starts.
model CareerRoleStack {
  roleId    String     @map("role_id") @db.Uuid
  role      CareerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  stackId   String     @map("stack_id") @db.Uuid
  stack     Stack      @relation(fields: [stackId], references: [id])
  position  Int
  isDefault Boolean    @map("is_default")

  @@id([roleId, stackId])
  @@index([stackId])
  @@map("career_role_stacks")
}

/// The curated topic taxonomy shared across tracks (spec §4.2). Referenced, never duplicated.
model Topic {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  /// True while `/content/seed` is still the source of this row's content: the importer sets it,
  /// and any edit made in the CMS clears it, so a re-import never undoes an expert's work
  /// (ADR-0014 decision 5). A status change is not an edit and leaves it alone.
  seedManaged Boolean  @default(false) @map("seed_managed")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tracks    TrackTopic[]
  lessons   Lesson[]
  questions Question[]

  @@map("topics")
}

/// A programme for one role and level. At most one may be published per (role, level) — enforced
/// by a partial unique index in the migration, so the candidate API always finds exactly one.
model Track {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  /// The catalogue role and level this track is for (ADR-0015). A track is still keyed by the
  /// pair — the stack dimension is on questions and on the profile, not here (M2.5 decision 4).
  roleId            String        @map("role_id") @db.Uuid
  role              CareerRole    @relation(fields: [roleId], references: [id])
  levelId           String        @map("level_id") @db.Uuid
  level             CareerLevel   @relation(fields: [levelId], references: [id])
  title             String
  summary           String?
  status            ContentStatus @default(draft)
  version           Int           @default(1)
  /// See `Topic.seedManaged`: `/content/seed` owns this row's content until the CMS edits it.
  seedManaged       Boolean       @default(false) @map("seed_managed")
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  /// True when `/content/seed` imported this row from a file whose `author` is `ai_draft` — a
  /// model wrote it and no person has vouched for it yet (ADR-0014 decision 6). Cleared by the
  /// explicit "mark as reviewed" action, or by a re-import from a file that says `author: human`.
  /// A content edit does NOT clear it: a typo fix is not a review of the whole item.
  aiDraftUnreviewed Boolean       @default(false) @map("ai_draft_unreviewed")
  /// Who marked it reviewed, and when. A plain uuid with no foreign key, tombstoned on erasure
  /// like the other authorship columns (ADR-0011).
  reviewedByUserId  String?       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  modules Module[]
  topics  TrackTopic[]

  @@index([roleId, levelId, status])
  /// The CMS list order (`updated_at desc, id desc`); without it every page sorts the table.
  @@index([updatedAt, id])
  @@map("tracks")
}

/// Which topics a track covers, and which of them are core (drives readiness coverage, spec §7).
model TrackTopic {
  trackId String  @map("track_id") @db.Uuid
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  topicId String  @map("topic_id") @db.Uuid
  topic   Topic   @relation(fields: [topicId], references: [id])
  isCore  Boolean @map("is_core")

  @@id([trackId, topicId])
  @@index([topicId])
  @@map("track_topics")
}

/// A section of a track. Structural: it has no status of its own and rides on its track's.
model Module {
  id          String   @id @default(uuid()) @db.Uuid
  trackId     String   @map("track_id") @db.Uuid
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  summary     String?
  /// Order within the track; ties break by slug, so reordering never needs a unique swap.
  position    Int
  /// See `Topic.seedManaged`: `/content/seed` owns this row's content until the CMS edits it.
  seedManaged Boolean  @default(false) @map("seed_managed")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons Lesson[]

  @@unique([trackId, slug])
  @@index([trackId, position])
  @@map("modules")
}

model Lesson {
  id                String        @id @default(uuid()) @db.Uuid
  moduleId          String        @map("module_id") @db.Uuid
  module            Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug              String        @unique
  title             String
  /// Markdown. Rendered on the server for candidates; the admin preview renders it in the browser.
  body              String
  topicId           String?       @map("topic_id") @db.Uuid
  topic             Topic?        @relation(fields: [topicId], references: [id])
  position          Int
  estimatedMinutes  Int?          @map("estimated_minutes")
  status            ContentStatus @default(draft)
  version           Int           @default(1)
  /// See `Topic.seedManaged`: `/content/seed` owns this row's content until the CMS edits it.
  seedManaged       Boolean       @default(false) @map("seed_managed")
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  /// True when `/content/seed` imported this row from a file whose `author` is `ai_draft` — a
  /// model wrote it and no person has vouched for it yet (ADR-0014 decision 6). Cleared by the
  /// explicit "mark as reviewed" action, or by a re-import from a file that says `author: human`.
  /// A content edit does NOT clear it: a typo fix is not a review of the whole item.
  aiDraftUnreviewed Boolean       @default(false) @map("ai_draft_unreviewed")
  /// Who marked it reviewed, and when. A plain uuid with no foreign key, tombstoned on erasure
  /// like the other authorship columns (ADR-0011).
  reviewedByUserId  String?       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([moduleId, position])
  @@index([status])
  @@index([topicId])
  /// The CMS list order (`updated_at desc, id desc`).
  @@index([updatedAt, id])
  @@map("lessons")
}

/// How an answer is scored (spec §6.1). A rubric may serve several questions.
model Rubric {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  name              String
  status            ContentStatus @default(draft)
  version           Int           @default(1)
  /// See `Topic.seedManaged`: `/content/seed` owns this row's content until the CMS edits it.
  seedManaged       Boolean       @default(false) @map("seed_managed")
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  /// True when `/content/seed` imported this row from a file whose `author` is `ai_draft` — a
  /// model wrote it and no person has vouched for it yet (ADR-0014 decision 6). Cleared by the
  /// explicit "mark as reviewed" action, or by a re-import from a file that says `author: human`.
  /// A content edit does NOT clear it: a typo fix is not a review of the whole item.
  aiDraftUnreviewed Boolean       @default(false) @map("ai_draft_unreviewed")
  /// Who marked it reviewed, and when. A plain uuid with no foreign key, tombstoned on erasure
  /// like the other authorship columns (ADR-0011).
  reviewedByUserId  String?       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  criteria           RubricCriterion[]
  questions          Question[]
  interviewQuestions InterviewSessionQuestion[]

  @@index([status])
  /// The CMS list order (`updated_at desc, id desc`).
  @@index([updatedAt, id])
  @@map("rubrics")
}

model RubricCriterion {
  id          String   @id @default(uuid()) @db.Uuid
  rubricId    String   @map("rubric_id") @db.Uuid
  rubric      Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  dimension   String
  description String
  /// Percentage share; a rubric's criteria must total 100 before it can be published.
  weight      Int
  /// Descriptors for levels 0–4, keyed by the level as a string (spec §6.1).
  levels      Json
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([rubricId, position])
  @@map("rubric_criteria")
}

model Question {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  type              QuestionType
  topicId           String        @map("topic_id") @db.Uuid
  topic             Topic         @relation(fields: [topicId], references: [id])
  subtopic          String?
  /// 1–5 (spec §6.1).
  difficulty        Int
  prompt            String
  context           String?
  rubricId          String        @map("rubric_id") @db.Uuid
  rubric            Rubric        @relation(fields: [rubricId], references: [id])
  /// ANSWER KEY: what a strong answer covers. Never included in a candidate-facing response.
  idealPoints       String[]      @map("ideal_points")
  /// ANSWER KEY: `[{ criterion, probe }]` — the probe the engine may ask for each rubric criterion
  /// the opening prompt does not ask for (owner's decision, 2026-09-23). `criterion` is the
  /// criterion's `position` in this question's rubric, not its id: criteria are replaced wholesale
  /// on every rubric edit, so their uuids do not survive one. Json rather than a child table for
  /// the same reason `RubricCriterion.levels` is: it is read and written as one value, and M3 pins
  /// it into the session snapshot whole. Validated by `PlannedFollowUp` at the boundary.
  plannedFollowUps  Json          @default("[]") @map("planned_follow_ups")
  status            ContentStatus @default(draft)
  version           Int           @default(1)
  /// See `Topic.seedManaged`: `/content/seed` owns this row's content until the CMS edits it.
  seedManaged       Boolean       @default(false) @map("seed_managed")
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  /// True when `/content/seed` imported this row from a file whose `author` is `ai_draft` — a
  /// model wrote it and no person has vouched for it yet (ADR-0014 decision 6). Cleared by the
  /// explicit "mark as reviewed" action, or by a re-import from a file that says `author: human`.
  /// A content edit does NOT clear it: a typo fix is not a review of the whole item.
  aiDraftUnreviewed Boolean       @default(false) @map("ai_draft_unreviewed")
  /// Who marked it reviewed, and when. A plain uuid with no foreign key, tombstoned on erasure
  /// like the other authorship columns (ADR-0011).
  reviewedByUserId  String?       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// pgvector, 1024 dimensions (ADR-0006). Prisma cannot read or write this type, so every
  /// query that touches it lives in question-embeddings.repository.ts as raw SQL.
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?                      @map("embedding_model")
  embeddedAt     DateTime?                    @map("embedded_at") @db.Timestamptz(6)

  flags ContentFlag[]

  /// Which roles and levels this question is offered to (ADR-0015). Many-to-many, so one question
  /// can serve frontend and full-stack without being written twice — which is the whole reason a
  /// full-stack track costs almost no new content.
  roles  QuestionCareerRole[]
  levels QuestionCareerLevel[]

  /// Which stack variants this question is for — and **no rows means general to its role**
  /// (ADR-0015). Tagging is how a Spring candidate and a Node candidate stop being asked the
  /// same thing; not tagging is how most questions stay available to everyone.
  stacks QuestionStack[]

  /// Sessions this question has been put to, pinned at the version they used.
  interviewQuestions InterviewSessionQuestion[]

  @@index([status])
  @@index([topicId])
  @@index([type, difficulty])
  /// The CMS list order (`updated_at desc, id desc`).
  @@index([updatedAt, id])
  @@map("questions")
}

/// Which roles a question is asked for. No row for a role means the question is not offered to it.
model QuestionCareerRole {
  questionId String     @map("question_id") @db.Uuid
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  roleId     String     @map("role_id") @db.Uuid
  role       CareerRole @relation(fields: [roleId], references: [id])

  @@id([questionId, roleId])
  @@index([roleId])
  @@map("question_career_roles")
}

/// Which levels a question is asked at. The same shape, and read the same way.
model QuestionCareerLevel {
  questionId String      @map("question_id") @db.Uuid
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  levelId    String      @map("level_id") @db.Uuid
  level      CareerLevel @relation(fields: [levelId], references: [id])

  @@id([questionId, levelId])
  @@index([levelId])
  @@map("question_career_levels")
}

/// A question tagged for a stack variant. An **absent** row is the meaningful state here: a
/// question with no rows at all is general to its role, so this table says "only these", never
/// "also these" (ADR-0015).
model QuestionStack {
  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  stackId    String   @map("stack_id") @db.Uuid
  stack      Stack    @relation(fields: [stackId], references: [id])

  @@id([questionId, stackId])
  @@index([stackId])
  @@map("question_stacks")
}

/// A candidate's report about a question (spec §6.1). Personal to them: it cascades on deletion.
model ContentFlag {
  id         String            @id @default(uuid()) @db.Uuid
  questionId String            @map("question_id") @db.Uuid
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String            @map("user_id") @db.Uuid
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     ContentFlagReason
  note       String?
  status     ContentFlagStatus @default(open)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?         @map("resolved_at") @db.Timestamptz(6)

  @@index([questionId, status])
  @@index([userId])
  @@map("content_flags")
}

enum ContentFlagReason {
  unclear
  incorrect
  duplicate
  offensive
  other

  @@map("content_flag_reason")
}

enum ContentFlagStatus {
  open
  reviewing
  resolved
  rejected

  @@map("content_flag_status")
}

/// Version history for every editable content entity: the row as it was before the change that
/// produced the next version. One table rather than a shadow table per entity (ADR-0014).
model ContentVersion {
  id              String            @id @default(uuid()) @db.Uuid
  entityType      ContentEntityType @map("entity_type")
  entityId        String            @map("entity_id") @db.Uuid
  version         Int
  /// The entity as it stood, including its children (a rubric carries its criteria).
  snapshot        Json
  changedByUserId String?           @map("changed_by_user_id") @db.Uuid
  changeNote      String?           @map("change_note")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@map("content_versions")
}

// ---------------------------------------------------------------------------------------------
// The interview engine (M3; spec §4.3, §6.1). Our code owns the flow: the LLM phrases what is
// said inside a state and never decides which state comes next, how long a session runs, or which
// questions are asked (CLAUDE.md §5).
//
// Everything here is the candidate's own record of a conversation they had, so every table
// cascades from `users` and none of it is kept after erasure (ADR-0011) — there is no tombstoned
// column in this section, and a new one would need an entry in `TOMBSTONED_COLUMNS`.

enum InterviewState {
  intro
  question
  follow_up
  candidate_questions
  wrap_up
  ended

  @@map("interview_state")
}

/// Lifecycle, which is not a state: leaving the page is a pause and coming back before the
/// deadline resumes, so there is no `paused` here. A sweep marks what nobody returned to.
enum InterviewStatus {
  in_progress
  completed
  abandoned

  @@map("interview_status")
}

/// `voice` is M5. The value exists now so that M5 adds a transport, not an enum value.
enum InterviewMode {
  text
  voice

  @@map("interview_mode")
}

/// `neutral` and `tough` are [P2] (spec §4.3).
enum InterviewPersona {
  friendly

  @@map("interview_persona")
}

enum TurnSpeaker {
  interviewer
  candidate

  @@map("turn_speaker")
}

/// One mock interview. Cascades from the user: a transcript is personal data.
///
/// **It pins every piece of content it was run against** — question, rubric, role, level and stack
/// — by id *and* version, and `InterviewSessionQuestion.snapshot` holds the content itself
/// (`tasks/todo.md` "Carried forward"). Content keeps changing after a session: an admin edits a
/// published question, an expert reworks a rubric's weights, `pnpm db:seed -- --force` re-imports a
/// bank, someone renames a role. None of that may move a report a candidate has already read.
model InterviewSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Who this session interviewed, from the catalogue (ADR-0015) — and at which version, because
  /// roles, levels and stacks are versioned content and renaming one must not rewrite history.
  careerRoleId  String      @map("career_role_id") @db.Uuid
  careerRole    CareerRole  @relation(fields: [careerRoleId], references: [id], onDelete: Restrict)
  roleVersion   Int         @map("role_version")
  careerLevelId String      @map("career_level_id") @db.Uuid
  careerLevel   CareerLevel @relation(fields: [careerLevelId], references: [id], onDelete: Restrict)
  levelVersion  Int         @map("level_version")
  /// Null is a real answer: "no variant" means the general questions for the role, which is what
  /// `question-eligibility.ts` offers a candidate who has not chosen one.
  stackId       String?     @map("stack_id") @db.Uuid
  stack         Stack?      @relation(fields: [stackId], references: [id], onDelete: Restrict)
  stackVersion  Int?        @map("stack_version")

  /// Which kinds of question this session may use — a subset of the role's
  /// `supported_question_types`. All of them is the preset mixed session.
  types          QuestionType[]
  mode           InterviewMode    @default(text)
  persona        InterviewPersona @default(friendly)
  /// The 15-minute preset from `/home` that seeds the first readiness score (spec §4.1).
  isDiagnostic   Boolean          @default(false) @map("is_diagnostic")
  plannedMinutes Int              @map("planned_minutes")
  /// The cap on questions; the time budget is the authoritative one (see `INTERVIEW_PLANS`).
  questionBudget Int              @map("question_budget")
  maxFollowUps   Int              @map("max_follow_ups")

  state  InterviewState  @default(intro)
  status InterviewStatus @default(in_progress)

  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  /// The wall-clock deadline. The screen counts to this rather than ticking a counter, so a
  /// backgrounded phone cannot drift and a resumed session does not gain the time it was away.
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)

  /// The catalogue's slugs and names as they read at session time (`SessionCatalogue`). The FKs
  /// and versions above are for joins and analytics; this is what the session *says it was*. A
  /// role renamed afterwards must not rewrite a report the candidate has already read, and
  /// `content_versions` cannot answer that question — it snapshots a row *before* a change, so
  /// the third edit leaves no record of the second.
  catalogue Json

  /// Seeds the deterministic question selection, so a session can be replayed exactly.
  selectionSeed  String @map("selection_seed")
  /// Which prompt version each interviewer call used, e.g. `{"interview_followup": 1}`. A released
  /// version is never edited in place, so this keeps meaning what it meant (CLAUDE.md "Prompts").
  promptVersions Json   @map("prompt_versions")
  /// Provider and model per purpose, as config resolved them at session start.
  modelConfig    Json   @map("model_config")
  /// The engine's own state, returned by the worker on every turn. Redis holds the live copy with
  /// a TTL; this is what a Redis flush costs a round trip instead of a session.
  engineSnapshot Json?  @map("engine_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  questions InterviewSessionQuestion[]
  turns     SessionTurn[]

  /// The Practice list: one candidate's sessions, keyset-paged by `(updated_at, id)`.
  @@index([userId, updatedAt, id])
  /// The stale-session sweep reads `in_progress` sessions past their deadline.
  @@index([status, endsAt])
  /// Question selection asks what this candidate has already been shown, newest sessions first.
  @@index([userId, startedAt])
  @@map("interview_sessions")
}

/// One question as it was put to one candidate, pinned.
///
/// `snapshot` is a **copy**, not a reference: `content_versions` snapshots a row *before* a change
/// (ADR-0014 decision 2), so a version number alone cannot reconstruct what was current at session
/// time — the third edit leaves no record of the second. It carries the prompt, context, ideal
/// points, the rubric's criteria and the planned follow-ups, validated by `SessionQuestionSnapshot`.
///
/// It is answer key, so it never leaves the API: the worker gets `BundleQuestion` (no rubric, no
/// ideal points) and the browser gets `CandidateSessionQuestion` (no answer key at all).
model InterviewSessionQuestion {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// 0-based order within the session.
  position  Int

  questionId      String   @map("question_id") @db.Uuid
  question        Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion Int      @map("question_version")
  rubricId        String   @map("rubric_id") @db.Uuid
  rubric          Rubric   @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  rubricVersion   Int      @map("rubric_version")

  snapshot Json

  /// Null until the engine reaches it — which is also what keeps an unasked question out of the
  /// candidate's own view of the session.
  askedAt        DateTime? @map("asked_at") @db.Timestamptz(6)
  followUpsAsked Int       @default(0) @map("follow_ups_asked")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  turns SessionTurn[]

  @@unique([sessionId, position])
  @@index([questionId])
  @@map("interview_session_questions")
}

/// One line of the transcript (spec §6.1).
model SessionTurn {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Monotonic within a session. The API persists turns idempotently by `(session_id, seq)`, so a
  /// retried worker response cannot write a line twice.
  seq       Int

  speaker TurnSpeaker
  state   InterviewState

  sessionQuestionId String?                   @map("session_question_id") @db.Uuid
  sessionQuestion   InterviewSessionQuestion? @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  /// Which of the question's **planned** follow-ups was asked — an index into
  /// `planned_follow_ups`, so the transcript says which probe was used rather than only that one
  /// was. M4 reads it for "did this answer need prompting?" (closing handover, 2026-09-25).
  followUpIndex     Int?                      @map("follow_up_index")

  text          String
  /// Milliseconds from `started_at`, so a transcript is readable without joining the session.
  startedMs     Int    @map("started_ms")
  endedMs       Int    @map("ended_ms")
  /// Voice mode only (M5).
  sttConfidence Float? @map("stt_confidence")

  /// The per-criterion coverage log, on candidate turns only: one entry per rubric criterion,
  /// whether this answer touched it, and which follow-up the engine then chose
  /// (`CriterionCoverage`). It is what makes "a menu, not a script" auditable. A model's judgement
  /// about an answer, recorded as evidence of what the engine decided — **never** a score, and
  /// never a substitute for M4's own per-answer evaluation.
  criteriaCovered Json? @map("criteria_covered")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sessionId, seq])
  @@index([sessionQuestionId])
  @@map("session_turns")
}
