# Test defaults: the local infra/docker-compose.yml services, in a separate database (readi_test)
# and Redis DB 1 so tests never touch development data. No secrets here.
# Variables already set in the environment (e.g. by CI) take precedence.
NODE_ENV=test
DATABASE_URL=postgresql://readi:readi@127.0.0.1:15432/readi_test
REDIS_URL=redis://127.0.0.1:16379/1
HEALTH_CHECK_TIMEOUT_MS=1000
PUBLIC_WEB_URL=http://localhost:3002
BETTER_AUTH_SECRET=test-only-secret-not-used-anywhere-else-0123456789
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WEB_PROXY_SECRET=test-only-proxy-secret-0123456789abcdef
