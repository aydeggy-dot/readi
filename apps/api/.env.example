# API configuration. Copy to apps/api/.env for local development.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Postgres and Redis from infra/docker-compose.yml (host ports 15432 and 16379).
DATABASE_URL=postgresql://readi:readi@127.0.0.1:15432/readi
REDIS_URL=redis://127.0.0.1:16379/0
HEALTH_CHECK_TIMEOUT_MS=2000
# Leave empty to disable Sentry.
SENTRY_DSN=

# --- Auth (ADR-0005, ADR-0009) ---
# Web origin; the browser reaches the API through the web app's /api rewrite.
PUBLIC_WEB_URL=http://localhost:3002
# Random secret, at least 32 characters. Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Google sign-in: leave both empty to disable. OAuth client type "Web application";
# authorised redirect URI: http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_RATE_LIMIT_ENABLED=true
# Same value as WEB_PROXY_SECRET in apps/web/.env.local; lets the API trust the client IP the web
# proxy forwards (per-IP auth rate limits). Generate with: openssl rand -base64 48
WEB_PROXY_SECRET=
OTP_MAX_PER_NUMBER_PER_HOUR=5
OTP_MAX_PER_NUMBER_PER_DAY=10

# --- Email: console (dev mailbox, default) or resend ---
EMAIL_PROVIDER=console
EMAIL_FROM="Readi <no-reply@localhost>"
RESEND_API_KEY=

# --- SMS: console (logs OTPs + dev mailbox, default) or termii ---
SMS_PROVIDER=console
TERMII_API_KEY=
# Sender ID approved by Termii for the DND route.
TERMII_SENDER_ID=
# Your account's base URL from the Termii dashboard, e.g. https://v3.api.termii.com
TERMII_BASE_URL=

# Object storage (S3 API). Defaults match the local SeaweedFS in infra/docker-compose.yml; run
# `pnpm storage:setup` once to add CORS for browser uploads and the upload-expiry rule.
# Production: Cloudflare R2 (https://<account>.r2.cloudflarestorage.com, region "auto").
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=readi-dev
S3_ACCESS_KEY_ID=readi-dev
S3_SECRET_ACCESS_KEY=readi-dev-secret
S3_FORCE_PATH_STYLE=true

# AI worker (ADR-0004). AI_WORKER_TOKEN must equal SERVICE_TOKEN in apps/ai-worker/.env.
# Generate with: openssl rand -base64 48
AI_WORKER_URL=http://127.0.0.1:8000
AI_WORKER_TOKEN=
AI_WORKER_TIMEOUT_MS=150000

# Background jobs (BullMQ on REDIS_URL); set JOBS_ENABLED=false to run an API without a job worker.
JOBS_ENABLED=true
QUEUE_PREFIX=readi
