{
  "name": "@readi/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node -e \"console.log('db:seed: nothing to seed yet. The seed importer arrives in Milestone M2.')\""
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@readi/shared-types": "workspace:*",
    "@sentry/nestjs": "10.72.0",
    "ioredis": "6.0.0",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@readi/config": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/supertest": "7.2.1",
    "chokidar": "5.0.0",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  }
}
