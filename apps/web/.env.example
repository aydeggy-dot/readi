# Web configuration. Copy to apps/web/.env.local for local development.
# Server-side URL of the API (the browser reaches it same-origin via the /api/* rewrite).
API_INTERNAL_URL=http://127.0.0.1:4000
# Leave empty to disable Sentry / PostHog.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
