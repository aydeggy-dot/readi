# Web configuration. Copy to apps/web/.env.local for local development.
# Server-side URL of the API (the browser reaches it same-origin via the /api/* rewrite).
API_INTERNAL_URL=http://127.0.0.1:4000
# Leave empty to disable Sentry / PostHog.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Deployment environment (NODE_ENV is always "production" in `next build`, so it cannot be used).
APP_ENV=development
# Same value as WEB_PROXY_SECRET in apps/api/.env. Lets the API trust the client IP this proxy
# forwards (per-IP auth rate limits). Generate with: openssl rand -base64 48
WEB_PROXY_SECRET=
# Header your hosting edge sets to the client IP (e.g. cf-connecting-ip). Leave empty locally.
CLIENT_IP_HEADER=
