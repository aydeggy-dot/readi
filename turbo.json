{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "APP_ENV",
        "API_INTERNAL_URL",
        "SENTRY_DSN",
        "WEB_PROXY_SECRET",
        "CLIENT_IP_HEADER",
        "NEXT_PUBLIC_*"
      ]
    },
    "gen:contracts": {
      "dependsOn": ["^gen:contracts", "build"],
      "outputs": ["generated/**", "readi_worker/contracts/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "gen:contracts"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "DATABASE_POOL_MAX", "REDIS_URL", "S3_ENDPOINT"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "AI_WORKER_TIMEOUT_MS",
        "AI_WORKER_TOKEN",
        "AI_WORKER_URL",
        "ANTHROPIC_API_KEY",
        "API_INTERNAL_URL",
        "APP_ENV",
        "AUTH_RATE_LIMIT_ENABLED",
        "BETTER_AUTH_SECRET",
        "CLIENT_IP_HEADER",
        "DATABASE_POOL_MAX",
        "DATABASE_URL",
        "EMAIL_FROM",
        "EMAIL_PROVIDER",
        "ENVIRONMENT",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "HEALTH_CHECK_TIMEOUT_MS",
        "HOST",
        "JOBS_ENABLED",
        "LLM_MODEL_CV_PARSE",
        "LLM_PROVIDER",
        "LLM_TIMEOUT_S",
        "LOG_LEVEL",
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "OTP_MAX_PER_NUMBER_PER_DAY",
        "OTP_MAX_PER_NUMBER_PER_HOUR",
        "PORT",
        "PUBLIC_WEB_URL",
        "QUEUE_PREFIX",
        "REDIS_URL",
        "RESEND_API_KEY",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_FORCE_PATH_STYLE",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY",
        "SENTRY_DSN",
        "SERVICE_TOKEN",
        "SMS_PROVIDER",
        "SUPPORT_EMAIL",
        "TERMII_API_KEY",
        "TERMII_BASE_URL",
        "TERMII_SENDER_ID",
        "WEB_PROXY_SECRET"
      ]
    }
  }
}
