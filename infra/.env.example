# Optional overrides for infra/docker-compose.yml. Copy to infra/.env to change them.
# If you change a port or credential, update DATABASE_URL / REDIS_URL / S3_* in the apps' .env files too.
READI_POSTGRES_USER=readi
READI_POSTGRES_PASSWORD=readi
READI_POSTGRES_DB=readi
READI_POSTGRES_PORT=15432
READI_REDIS_PORT=16379
READI_S3_PORT=19000
READI_S3_ACCESS_KEY=readi-dev
READI_S3_SECRET_KEY=readi-dev-secret
READI_S3_BUCKET=readi-dev
READI_LIVEKIT_PORT=7880
READI_LIVEKIT_RTC_TCP_PORT=7881
READI_LIVEKIT_RTC_UDP_PORT=7882
