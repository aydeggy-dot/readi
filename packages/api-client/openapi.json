{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth-methods": {
      "get": {
        "operationId": "AuthMethodsController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMethodsResponseDto_Output"
                }
              }
            }
          }
        },
        "tags": ["auth"]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "All dependencies are healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto_Output"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is failing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto_Output"
                }
              }
            }
          }
        },
        "tags": ["health"]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "MeController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in"
          }
        },
        "tags": ["users"]
      }
    },
    "/api/me/onboarding/complete": {
      "post": {
        "operationId": "MeController_complete",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingStateDto_Output"
                }
              }
            }
          },
          "409": {
            "description": "A required step is missing (`profile_required`, `consents_required`)"
          }
        },
        "tags": ["users"]
      }
    },
    "/api/me/profile": {
      "get": {
        "operationId": "ProfilesController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto_Output"
                }
              }
            }
          },
          "404": {
            "description": "No profile yet (code `profile_not_found`)"
          }
        },
        "tags": ["profile"]
      },
      "put": {
        "operationId": "ProfilesController_put",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "Invalid profile"
          }
        },
        "tags": ["profile"]
      }
    },
    "/api/me/consents": {
      "get": {
        "operationId": "ConsentsController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentsResponseDto_Output"
                }
              }
            }
          }
        },
        "tags": ["consents"]
      },
      "put": {
        "operationId": "ConsentsController_put",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateConsentsRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentsResponseDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "Invalid decisions (e.g. a type listed twice)"
          },
          "409": {
            "description": "A decision was made against an outdated consent text (`consent_version_outdated`)"
          }
        },
        "tags": ["consents"]
      }
    },
    "/api/me/cv": {
      "get": {
        "operationId": "CvController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvResponseDto_Output"
                }
              }
            }
          }
        },
        "tags": ["cv"]
      },
      "post": {
        "operationId": "CvController_confirm",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmCvUploadRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvResponseDto_Output"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or expired upload (`upload_not_found`)"
          },
          "409": {
            "description": "`upload_incomplete`, `profile_required` or `cv_changed`"
          },
          "422": {
            "description": "Not a PDF/DOCX of the declared size (`invalid_file`)"
          },
          "429": {
            "description": "Too many CVs parsed recently (`rate_limited`)"
          }
        },
        "tags": ["cv"]
      },
      "delete": {
        "operationId": "CvController_remove",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvResponseDto_Output"
                }
              }
            }
          }
        },
        "tags": ["cv"]
      }
    },
    "/api/me/cv/uploads": {
      "post": {
        "operationId": "CvController_createUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCvUploadRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvUploadResponseDto_Output"
                }
              }
            }
          },
          "409": {
            "description": "No profile yet (`profile_required`)"
          },
          "429": {
            "description": "Too many uploads (`rate_limited`)"
          }
        },
        "tags": ["cv"]
      }
    },
    "/api/me/cv/parsed": {
      "put": {
        "operationId": "CvController_updateParsed",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParsedCvDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvResponseDto_Output"
                }
              }
            }
          },
          "409": {
            "description": "No CV, or still processing (`cv_not_editable`)"
          }
        },
        "tags": ["cv"]
      }
    },
    "/api/admin/stats": {
      "get": {
        "operationId": "AdminController_stats",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminStatsDto_Output"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin"
          }
        },
        "tags": ["admin"]
      }
    }
  },
  "info": {
    "title": "Readi API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AuthMethodsResponseDto_Output": {
        "type": "object",
        "properties": {
          "google": {
            "type": "boolean"
          }
        },
        "required": ["google"],
        "additionalProperties": false
      },
      "HealthStatus_Output": {
        "type": "string",
        "enum": ["ok", "error"]
      },
      "HealthCheckResult_Output": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus_Output"
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "$ref": "#/components/schemas/HealthCheckError_Output"
          }
        },
        "required": ["status", "latency_ms"],
        "additionalProperties": false
      },
      "HealthCheckError_Output": {
        "type": "string",
        "enum": ["unreachable", "timeout", "not_migrated"]
      },
      "HealthResponseDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus_Output"
          },
          "service": {
            "type": "string",
            "enum": ["api", "ai-worker"]
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheckResult_Output"
            }
          }
        },
        "required": ["status", "service", "checks"],
        "additionalProperties": false
      },
      "OnboardingState_Output": {
        "type": "object",
        "properties": {
          "profile_completed": {
            "type": "boolean"
          },
          "consents_completed": {
            "type": "boolean"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "nullable": true
          }
        },
        "required": ["profile_completed", "consents_completed", "completed_at"],
        "additionalProperties": false
      },
      "MeResponseDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["candidate", "content_expert", "admin"]
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "nullable": true
          },
          "email_verified": {
            "type": "boolean"
          },
          "phone_number": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{7,14}$",
            "nullable": true
          },
          "phone_number_verified": {
            "type": "boolean"
          },
          "signup_method": {
            "type": "string",
            "enum": ["email", "google", "phone"]
          },
          "onboarding": {
            "$ref": "#/components/schemas/OnboardingState_Output"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "email",
          "email_verified",
          "phone_number",
          "phone_number_verified",
          "signup_method",
          "onboarding"
        ],
        "additionalProperties": false
      },
      "OnboardingStateDto_Output": {
        "type": "object",
        "properties": {
          "profile_completed": {
            "type": "boolean"
          },
          "consents_completed": {
            "type": "boolean"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "nullable": true
          }
        },
        "required": ["profile_completed", "consents_completed", "completed_at"],
        "additionalProperties": false
      },
      "TargetRole_Output": {
        "type": "string",
        "enum": ["frontend", "backend", "qa"]
      },
      "ExperienceLevel_Output": {
        "type": "string",
        "enum": ["intern_junior", "mid"]
      },
      "TargetCompanyType_Output": {
        "type": "string",
        "enum": ["local_startup", "enterprise_bank_telco", "remote_foreign", "big_tech"]
      },
      "ProfileResponseDto_Output": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "target_role": {
            "$ref": "#/components/schemas/TargetRole_Output"
          },
          "level": {
            "$ref": "#/components/schemas/ExperienceLevel_Output"
          },
          "years_experience": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "stack": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "target_company_type": {
            "$ref": "#/components/schemas/TargetCompanyType_Output"
          },
          "target_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "name",
          "target_role",
          "level",
          "years_experience",
          "stack",
          "target_company_type",
          "target_date",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "TargetRole": {
        "type": "string",
        "enum": ["frontend", "backend", "qa"]
      },
      "ExperienceLevel": {
        "type": "string",
        "enum": ["intern_junior", "mid"]
      },
      "TargetCompanyType": {
        "type": "string",
        "enum": ["local_startup", "enterprise_bank_telco", "remote_foreign", "big_tech"]
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "target_role": {
            "$ref": "#/components/schemas/TargetRole"
          },
          "level": {
            "$ref": "#/components/schemas/ExperienceLevel"
          },
          "years_experience": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "stack": {
            "minItems": 1,
            "maxItems": 15,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "target_company_type": {
            "$ref": "#/components/schemas/TargetCompanyType"
          },
          "target_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "nullable": true
          }
        },
        "required": [
          "name",
          "target_role",
          "level",
          "years_experience",
          "stack",
          "target_company_type",
          "target_date"
        ]
      },
      "ConsentStatus_Output": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ConsentType_Output"
          },
          "granted": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "current_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "nullable": true
          }
        },
        "required": ["type", "granted", "version", "current_version", "decided_at"],
        "additionalProperties": false
      },
      "ConsentType_Output": {
        "type": "string",
        "enum": ["audio_processing", "recording_storage", "camera_coaching", "marketing"]
      },
      "ConsentsResponseDto_Output": {
        "type": "object",
        "properties": {
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentStatus_Output"
            }
          }
        },
        "required": ["consents"],
        "additionalProperties": false
      },
      "ConsentDecision": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ConsentType"
          },
          "granted": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["type", "granted", "version"]
      },
      "ConsentType": {
        "type": "string",
        "enum": ["audio_processing", "recording_storage", "camera_coaching", "marketing"]
      },
      "UpdateConsentsRequestDto": {
        "type": "object",
        "properties": {
          "decisions": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentDecision"
            }
          }
        },
        "required": ["decisions"]
      },
      "CvStatus_Output": {
        "type": "string",
        "enum": ["none", "processing", "parsed", "unreadable", "failed"]
      },
      "CvContentType_Output": {
        "type": "string",
        "enum": [
          "application/pdf",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        ]
      },
      "CvParseError_Output": {
        "type": "string",
        "enum": [
          "no_text",
          "encrypted",
          "invalid_file",
          "too_large",
          "llm_error",
          "invalid_output",
          "worker_unavailable"
        ]
      },
      "ParsedCv_Output": {
        "type": "object",
        "properties": {
          "skills": {
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "projects": {
            "maxItems": 15,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CvProject_Output"
            }
          },
          "experience": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CvExperience_Output"
            }
          },
          "gaps": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": ["skills", "projects", "experience", "gaps"],
        "additionalProperties": false
      },
      "CvProject_Output": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "technologies": {
            "maxItems": 15,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        },
        "required": ["name", "description", "technologies"],
        "additionalProperties": false
      },
      "CvExperience_Output": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "organisation": {
            "type": "string",
            "maxLength": 120
          },
          "start": {
            "allOf": [
              {
                "$ref": "#/components/schemas/YearMonth_Output"
              }
            ],
            "nullable": true
          },
          "end": {
            "allOf": [
              {
                "$ref": "#/components/schemas/YearMonth_Output"
              }
            ],
            "nullable": true
          },
          "current": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "maxLength": 600
          }
        },
        "required": ["title", "organisation", "start", "end", "current", "summary"],
        "additionalProperties": false
      },
      "YearMonth_Output": {
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      },
      "CvResponseDto_Output": {
        "type": "object",
